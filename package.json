{
  "name": "buyerguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-production-browser.mjs",
    "start": "next start",
    "start:live": "node scripts/start-live-local.mjs",
    "model:setup": "node scripts/setup-local-model.mjs",
    "model:start": "node scripts/start-local-model.mjs",
    "verify:model:local": "tsx scripts/verify-local-model.ts",
    "voice:setup": "node scripts/setup-local-speech.mjs",
    "verify:voice:local": "tsx scripts/verify-local-speech.ts",
    "verify:voice:http": "tsx scripts/verify-local-speech-http.ts",
    "preview:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-preview.ps1",
    "preview:status": "node scripts/local-preview.mjs status",
    "preview:stop": "node scripts/local-preview.mjs stop",
    "verify:preview": "tsx scripts/verify-local-preview.ts --interrupt-owned-preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:paypal": "tsx scripts/verify-paypal.ts",
    "verify:paypal:journey": "tsx scripts/verify-paypal-journey.ts",
    "configure:paypal:webhook": "tsx scripts/configure-paypal-webhook.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:hosted": "tsx scripts/verify-hosted.ts",
    "verify:restart": "tsx scripts/verify-restart.ts",
    "prepare:restart": "tsx scripts/prepare-restart.ts",
    "verify:queue": "tsx scripts/verify-queue.ts",
    "verify:scenarios": "tsx scripts/verify-scenarios.ts",
    "package:release": "node scripts/package-release.mjs",
    "format": "prettier --write src scripts tests e2e *.ts *.mjs *.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "eval": "tsx scripts/evaluate.ts && tsx scripts/evaluate-frozen.ts",
    "eval:models": "tsx scripts/evaluate-model.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:integration": "tsx scripts/workflow-traces.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "verify:performance": "tsx scripts/verify-performance.ts",
    "verify:shopping": "tsx scripts/verify-shopping.ts",
    "verify:agent": "tsx scripts/verify-agent-hosted.ts",
    "verify:agent:live": "tsx scripts/verify-live-agent.ts",
    "verify:agent:groups": "tsx scripts/verify-agent-groups.ts",
    "verify:agent:restart": "tsx scripts/verify-agent-hosted.ts restart",
    "verify:research": "tsx scripts/verify-manufacturer-sources.ts",
    "verify:current": "tsx scripts/verify-current-hosted.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@google/genai": "2.27.0",
    "@react-three/fiber": "9.8.1",
    "dotenv": "18.0.5",
    "gsap": "3.15.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
