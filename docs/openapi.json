          "401": {
            "description": "Missing/expired session or invalid access code."
          },
          "403": {
            "description": "Wrong origin, party, or privileged role."
          },
          "404": {
            "description": "Resource is absent or is not owned by this shopper/workspace."
          },
          "429": {
            "description": "Per-actor request budget exhausted; Retry-After: 60. Actions 120/min, uploads 20/min, shopping analysis 10/min and engineering scenarios 20/min."
          }
        }
      }
    },
