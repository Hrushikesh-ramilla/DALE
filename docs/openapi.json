{
  "openapi": "3.1.0",
  "info": {
    "title": "Dale test storefront API",
    "version": "0.1.0",
    "description": "Sandbox/fixture commerce with separate buyer, seller and reviewer permissions. Synthetic adapters do not establish real payment completion. Case records and originals are private. No API key belongs in requests from browsers."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bg_session",
        "description": "Server-issued HttpOnly session cookie. Obtain with POST /api/session; do not publish cookies in traces."
      }
    },
    "schemas": {
      "Action": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "cancel_fulfillment"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "orderId",
              "reason"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "choose_remedy"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "request": {
                "type": "string",
                "enum": [
                  "refund",
                  "replacement"
                ]
              }
            },
            "required": [
              "action",
              "caseId",
              "request"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "authorize_return"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "prepaid",
                  "waive"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "labelReference": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "action",
              "caseId",
              "decision",
              "reason"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "return_shipping"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "in_transit",
                  "received"
                ]
              },
              "trackingReference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "action",
              "caseId",
              "status",
              "trackingReference"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "capture_session"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "checkpoint": {
                "type": "string",
                "enum": [
                  "seller_dispatch",
                  "buyer_receipt",
                  "buyer_return",
                  "seller_return"
                ]
              }
            },
            "required": [
              "action",
              "checkpoint"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "quote"
              },
              "productId": {
                "type": "string",
                "maxLength": 20
              },
              "model": {
                "type": "string",
                "maxLength": 80
              },
              "groupId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "action",
              "productId",
              "model"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "join_group"
              },
              "productId": {
                "type": "string",
                "maxLength": 20
              },
              "model": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "action",
              "productId",
              "model"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "leave_group"
              },
              "groupId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "action",
              "groupId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "checkout"
              },
              "quoteId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "fingerprint": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "action",
              "quoteId",
              "fingerprint"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "capture"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "action",
              "orderId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "scam"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              }
            },
            "required": [
              "action",
              "message"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "return"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "damaged",
                  "wrong_item",
                  "not_delivered",
                  "canceled"
                ]
              },
              "request": {
                "type": "string",
                "enum": [
                  "refund",
                  "replacement"
                ]
              }
            },
            "required": [
              "action",
              "orderId",
              "reason",
              "request"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "evidence"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "checkpoint": {
                "type": "string",
                "enum": [
                  "seller_dispatch",
                  "buyer_receipt",
                  "buyer_return",
                  "seller_return"
                ]
              },
              "serial": {
                "type": "string",
                "maxLength": 100
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "caseId",
              "checkpoint",
              "serial",
              "note"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "dispatch"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "serial": {
                "type": "string",
                "maxLength": 100
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "orderId",
              "serial",
              "note"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "analyze"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "action",
              "caseId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "resolve"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "remedy": {
                "type": "string",
                "enum": [
                  "refund",
                  "replacement"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "caseId",
              "remedy",
              "note"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "appeal"
              },
              "caseId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "action",
              "caseId",
              "note"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "ship"
              },
              "orderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "shipped",
                  "delivered"
                ]
              }
            },
            "required": [
              "action",
              "orderId",
              "status"
            ]
          }
        ]
      },
      "ShoppingBrief": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "model": {
            "type": "string",
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "",
              "chargers",
              "docks",
              "storage",
              "audio",
              "accessories"
            ]
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "preference": {
            "default": "",
            "type": "string",
            "maxLength": 80
          },
          "priority": {
            "default": "price",
            "type": "string",
            "enum": [
              "price",
              "features"
            ]
          },
          "confirmConstraints": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "model",
          "category",
          "budget"
        ]
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "security": [],
        "description": "Database readiness, build and server-instance identifier.",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "description": "Create an isolated shopper session, join a group invitation as a distinct buyer, or authorize a seller/reviewer for a customer's workspace. Operator roles require their separate access code. Mutations require an Origin header matching the configured app origin.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "buyer",
                      "seller",
                      "reviewer"
                    ]
                  },
                  "accessCode": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "workspaceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "invite": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful command or private snapshot; financial completion is reported separately in order/refund status."
          },
          "400": {
            "description": "Invalid fields, unsafe state transition, changed approval, or integrity error."
          },
          "401": {
            "description": "Missing/expired session or invalid access code."
          },
          "403": {
            "description": "Wrong origin, party, or privileged role."
          },
          "404": {
            "description": "Resource is absent or is not owned by this shopper/workspace."
          },
          "429": {
            "description": "Per-actor request budget exhausted; Retry-After: 60. Actions 120/min, uploads 20/min, shopping analysis 10/min and engineering scenarios 20/min."
          }
        }
      },
      "get": {
        "security": [
          {
            "session": []
          }
        ],
        "description": "Private snapshot, role, workspace ID and explicit adapter modes. Operators receive recovery heartbeat/backlog.",
        "responses": {
          "200": {
            "description": "Successful command or private snapshot; financial completion is reported separately in order/refund status."
          },
          "400": {
            "description": "Invalid fields, unsafe state transition, changed approval, or integrity error."
          },
          "401": {
            "description": "Missing/expired session or invalid access code."
          },
          "403": {
            "description": "Wrong origin, party, or privileged role."
          },
          "404": {
            "description": "Resource is absent or is not owned by this shopper/workspace."
          },
          "429": {
            "description": "Per-actor request budget exhausted; Retry-After: 60. Actions 120/min, uploads 20/min, shopping analysis 10/min and engineering scenarios 20/min."
          }
        }
      },
      "delete": {
        "security": [
          {
            "session": []
          }
        ],
        "description": "End the current session; requires same Origin.",
        "responses": {
          "200": {
            "description": "Successful command or private snapshot; financial completion is reported separately in order/refund status."
          },
          "400": {
            "description": "Invalid fields, unsafe state transition, changed approval, or integrity error."
          },
          "401": {
            "description": "Missing/expired session or invalid access code."
          },
          "403": {
            "description": "Wrong origin, party, or privileged role."
          },
          "404": {
            "description": "Resource is absent or is not owned by this shopper/workspace."
          },
          "429": {
            "description": "Per-actor request budget exhausted; Retry-After: 60. Actions 120/min, uploads 20/min, shopping analysis 10/min and engineering scenarios 20/min."
          }
        }
      }
    },
    "/api/actions": {
      "post": {
        "description": "Execute one typed domain command. Each command enforces ownership, actor role, approval and state rules. capture_session binds a code to exactly one case or order; only reviewers approve remedies/return arrangements; only the owning buyer changes remedy choices; only sellers cancel fulfillment. Mutations require an Origin header matching the configured app origin.",
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful command or private snapshot; financial completion is reported separately in order/refund status."
          },
          "400": {
            "description": "Invalid fields, unsafe state transition, changed approval, or integrity error."
          },
          "401": {
            "description": "Missing/expired session or invalid access code."
          },
          "403": {
            "description": "Wrong origin, party, or privileged role."
          },
          "404": {
            "description": "Resource is absent or is not owned by this shopper/workspace."
          },
          "429": {
            "description": "Per-actor request budget exhausted; Retry-After: 60. Actions 120/min, uploads 20/min, shopping analysis 10/min and engineering scenarios 20/min."
          }
        }
      }
    },
    "/api/brief": {
