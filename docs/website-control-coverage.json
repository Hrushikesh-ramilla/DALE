{
  "version": 1,
  "scope": "DALE customer interface; all product brands use the same mechanisms",
  "entries": [
    {
      "surface": "global destinations and breadcrumbs",
      "operation": "use_website.navigate / registered links",
      "service": "site-routes + Next router",
      "postcondition": "route and rendered page/entity",
      "status": "verified-local-contracts-and-browser-journeys",
      "test": "website-actions.spec.ts"
    },
    {
      "surface": "browser tabs",
      "operation": "use_website.tabs / tab",
      "service": "tab registration + browser coordinator",
      "postcondition": "each intended tab reports its destination; close observed by opener",
      "status": "verified-local-contracts-and-browser-journeys",
      "test": "website-actions.spec.ts"
    },
    {
      "surface": "search / filters / sorting / paging",
      "operation": "set_search_filters / observed controls",
      "service": "retrieval + concierge search page",
      "postcondition": "canonical constraints and ordered rendered results",
      "status": "verified-local-contracts-and-browser-journeys",
      "test": "website-actions.spec.ts"
    },
    {
      "surface": "category brand/search/sort/load-more controls",
      "operation": "use_website.control",
      "service": "existing category component handlers",
      "postcondition": "actual component values and category readiness",
      "status": "verified-full-catalog-sort-bound-cursors-and-real-category-browser-controls",
      "test": "catalog-order.test.ts / website-actions.spec.ts"
    },
    {
      "surface": "product exact variant",
      "operation": "catalog lookup + use_website.navigate",
      "service": "published SKU IDs",
      "postcondition": "exact SKU page rendered",
      "status": "verified-exact-published-SKU-navigation; ambiguity remains model-mediated"
    },
    {
      "surface": "product gallery / variant picker / page quantity selector",
      "operation": null,
      "status": "not-present",
      "evidence": "ProductDetailView renders one image and distinct SKU listings; no gallery, variant dropdown or quantity control exists"
    },
    {
      "surface": "cart / wishlist / move / quantity / group offer / clear / undo",
      "operation": "manage_collection / move_collection / undo_collection_change",
      "service": "shopping.manageBasket",
      "postcondition": "owner database basket and UI agree; replay applies once",
      "status": "verified-local-contracts-and-browser-journeys",
      "test": "website-execution.test.ts / website-actions.spec.ts"
    },
    {
      "surface": "comparison",
      "operation": "use_website.navigate /compare?ids=...",
      "service": "published product details + comparison page",
      "postcondition": "exact intended published IDs rendered",
      "status": "verified-local-contracts-and-browser-journeys"
    },
    {
      "surface": "group terms / join / leave",
      "operation": "get_group_deals / prepare_customer_action",
      "service": "existing group policy and customer confirmation",
      "postcondition": "owned confirmation followed by independent customer approval and real membership",
      "status": "verified-independent-browser-customers-and-service-contracts; live-provider-sampling-remains-separate",
      "test": "website-customer-flows.spec.ts / website-execution.test.ts"
    },
    {
      "surface": "cart checkout",
      "operation": "prepare_customer_action.checkout",
      "service": "shopping.prepareCheckout",
      "postcondition": "exact cart quotes and existing individual PayPal approvals",
      "status": "verified-cart-quotes-and-customer-approved-unpaid-orders-in-browser; sandbox-payment-integration-remains-separate",
      "test": "website-customer-flows.spec.ts / website-execution.test.ts",
      "interaction": "customer financial approval remains manual"
    },
    {
      "surface": "product direct fast checkout",
      "operation": "existing product button",
      "service": "store-context.choose",
      "postcondition": "single-product quote dialog",
      "status": "verified-actual-product-quote-review-in-browser; selected-product-cache-crash-fixed",
      "test": "website-customer-flows.spec.ts"
    },
    {
      "surface": "own orders / return / cancellation / remedy / appeal",
      "operation": "get_user_orders / prepare_customer_action",
      "service": "existing owner-scoped customer workflows",
      "postcondition": "owned resource and existing confirmation receipt",
      "status": "verified-owned-cancellation-and-return-confirmations-in-browser; remedy-and-appeal-service-contracts-verified-without-separate-live-browser-sampling",
      "test": "website-customer-flows.spec.ts / concierge.test.ts"
    },
    {
      "surface": "account authentication",
      "operation": "navigate account / observed sign-in entry",
      "service": "existing authentication",
      "postcondition": "actual account context",
      "status": "verified-account-entry-non-secret-fields-first-guest-task-and-cross-tab-logout-fencing; authentication user-mediated",
      "interaction": "passwords and authentication remain user-mediated"
    },
    {
      "surface": "support form fields / evidence upload / tracking",
      "operation": "customer component controls",
      "status": "verified-real-file-choice-form-submission-owner-only-download-and-binary-hash; shipping-and-other-owned-workflows-use-existing-controls-and-service-contracts",
      "test": "website-evidence.spec.ts / concierge.test.ts",
      "interaction": "file selection remains user-mediated; no arbitrary local file access"
    },
    {
      "surface": "menus / details / scroll / back-forward",
      "operation": "use_website.control / scroll / history",
      "service": "existing components + browser history",
      "postcondition": "actual visible component or page state",
      "status": "verified-menu-input-details-scroll-history-and-home-shop-readiness; protected-approval-and-assistant-editor-controls-remain-customer-operated",
      "test": "website-actions.spec.ts"
    },
    {
      "surface": "voice / keyboard / mobile",
      "operation": "existing transcript input invokes same turn executor",
      "service": "copilot input + speech adapter",
      "postcondition": "same action behavior as typed requests",
      "status": "verified-narrow-viewport-keyboard-journey-and-browser-microphone-to-local-Whisper-to-website-action; physical-microphone-and-device-matrix-not-certified",
      "test": "website-actions.spec.ts / website-voice.spec.ts"
    },
    {
      "surface": "external browser settings / seller controls / automatic payment approval",
      "operation": null,
      "status": "outside-approved-scope"
    }
  ]
}
