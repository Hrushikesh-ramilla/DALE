# Copy to .env. Never commit credentials.
APP_URL=http://localhost:3000
SESSION_SECRET=
# Set on hosted deployments. Local development uses embedded PostgreSQL.
DATABASE_URL=
LOCAL_DATA_DIR=.data
PAYMENT_MODE=fixture
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
AI_MODE=fixture
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
DEMO_ACCESS_CODE=
# Required to enable seller/reviewer demo roles; different from the buyer code.
OPERATOR_ACCESS_CODE=
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
