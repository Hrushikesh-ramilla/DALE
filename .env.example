# Copy to .env. Never commit credentials.
APP_URL=http://localhost:3000
SESSION_SECRET=
# Set on hosted deployments. Local development uses embedded PostgreSQL.
DATABASE_URL=
# Docker Compose only; use a URL-safe random value.
POSTGRES_PASSWORD=
LOCAL_DATA_DIR=.data
PAYMENT_MODE=fixture
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Optional distinct sandbox Personal buyer for manual acceptance; never use live credentials.
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
AI_MODE=fixture
AI_PROVIDER=cloud
## Local CPU recognition, independent of text/vision inference. Use absolute paths.
# VOICE_MODE=local
# LOCAL_SPEECH_EXECUTABLE=/opt/buyerguard/models/speech/whisper-cli
# LOCAL_SPEECH_MODEL=/opt/buyerguard/models/speech/ggml-tiny.bin
# self_hosted uses llama.cpp on loopback; no cloud key or quota is needed.
AI_SELF_HOSTED_BASE_URL=http://127.0.0.1:8081/v1
# qwen35 uses the model author's separate text/vision sampling profiles.
AI_SELF_HOSTED_PROFILE=
# Private local inference authentication, never a paid provider token.
AI_SELF_HOSTED_API_KEY=
# Model service cgroup limit; installer also checks combined host capacity.
LOCAL_MODEL_MEMORY_MAX_MIB=2048
# Leave unset for a direct Gemini key; set only for a compatible custom endpoint.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Read-only agent planning requires an explicit no-billing/free-quota verification.
AGENT_MODEL_ENABLED=false
AI_BILLING_DISABLED=false
AI_FREE_QUOTA_CONFIRMED=false
# Optional free HTTP revalidation of reviewed manufacturer sources. Demos always use snapshots.
REAL_RESEARCH_REFRESH_ENABLED=false
# Live voice stays disabled until free quota and billing-disabled status are verified.
VOICE_MODE=disabled
VOICE_MODEL=gemini-3.8-live
VOICE_FREE_TIER_CONFIRMED=false
VOICE_BILLING_DISABLED=false
DEMO_ACCESS_CODE=
# Required to enable seller/reviewer demo roles; different from the buyer code.
OPERATOR_ACCESS_CODE=
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
