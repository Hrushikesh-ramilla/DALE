[Unit]
Description=BuyerGuard storefront
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=buyerguard
Group=buyerguard
WorkingDirectory=/opt/buyerguard/current
EnvironmentFile=/etc/buyerguard.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
MemoryMax=380M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buyerguard /opt/buyerguard/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
